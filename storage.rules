rules_version = '2';

// CutQ Cloud Storage security rules.
//
// All media is publicly readable (salon logos, service photos, category icons,
// header images are shown in the customer app). Writes are restricted to the
// relevant salon staff / admin, and constrained to reasonably-sized images.
//
// Authorization uses CUSTOM AUTH CLAIMS (request.auth.token), NOT cross-service
// Firestore reads: cross-service rules (firestore.get/exists from Storage rules)
// do not evaluate on this project, so every Firestore-gated write was being
// denied. Claims are maintained by Cloud Functions (see refreshUserClaims /
// onSalonWrittenSyncClaims in functions/index.js):
//   token.role   = "ADMIN" | "SALONOWNER" | "SALONTEAM" | "SUPPORT"
//   token.salons = [salonId, ...]  (salons the user owns or is a team member of)
// Note: claims only appear in a user's token after their next sign-in / token
// refresh.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'ADMIN';
    }

    function managesSalon(salonId) {
      return isSignedIn()
        && request.auth.token.salons is list
        && salonId in request.auth.token.salons;
    }

    function validImage() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Salon media: logo, cover, gallery, service & stylist photos.
    match /salons/{salonId}/{allPaths=**} {
      allow read: if true;
      allow write: if validImage() && (isAdmin() || managesSalon(salonId));
    }

    // Admin-managed catalog media.
    match /service_categories/{allPaths=**} {
      allow read: if true;
      allow write: if validImage() && isAdmin();
    }
    match /service_subcategories/{allPaths=**} {
      allow read: if true;
      allow write: if validImage() && isAdmin();
    }
    match /explore_section/{allPaths=**} {
      allow read: if true;
      allow write: if validImage() && isAdmin();
    }
    match /app_config/{allPaths=**} { // header images
      allow read: if true;
      allow write: if validImage() && isAdmin();
    }

    // User profile photos (self-managed).
    match /Users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if validImage() && isSignedIn() && userId == uid();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
